<Window x:Class="Trabalho.OS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Trabalho.OS"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="700" 
        Width="850"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent">

    <Window.Resources>
        <!-- estilo,menu -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property ="Background" Value="#2B3035"/>
            <Setter Property="Foreground" Value="White" />
            <Setter  Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property= "Margin" Value="15,6"/>
            <Setter  Property="BorderThickness" Value ="0"/>
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property= "Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D6EFD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#212529" CornerRadius ="20" BorderBrush="#343A40" BorderThickness="1"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- menu,lateral -->
            <Border Grid.Column="0" Background="#1A1D20" CornerRadius="20,0,0,20" MouseLeftButtonDown="Border_MouseLeftButtonDown">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Top" Text="TECKY CELL" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,30,0,30"/>

                    <Button DockPanel.Dock="Top" Content="Orçamento" Style="{StaticResource MenuButtonStyle}" Click="BtnOrcamento_Click"/>
                    <Button DockPanel.Dock="Top" Content="Ordem de Serviço" Style="{StaticResource MenuButtonStyle}" Click="BtnOrdemServico_Click"/>
                    <Button DockPanel.Dock="Top" Content="Caixa" Style="{StaticResource MenuButtonStyle}" Click="BtnCaixa_Click"/>

                    <!--desligar -->
                    <Button DockPanel.Dock="Bottom" Content="Desligar" Margin="15,0,15,25" Height="45" Background="#DC3545" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnDesligar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>
            </Border>
            <ContentControl x:Name="MainContent" Grid.Column="1" Margin="20"/>
        </Grid>
    </Grid>
</Window>