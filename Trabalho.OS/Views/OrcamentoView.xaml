<UserControl x:Class="Trabalho.OS.Views.OrcamentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- cabeçalho orçamento -->
        <StackPanel Margin="5">
            <TextBlock Text="Orçamento" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
            <TextBlock Text="Tecky Cell Assistência Técnica : 02798837-2300" Foreground="#ADB5BD" Margin="0,0,0,10"/>

            <StackPanel Margin="0,0,0,12" HorizontalAlignment="Left" Width="150">
                <TextBlock Text="Data" Foreground="#ADB5BD" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtData" Height="32" Padding="5" Background="#2B3035" Foreground="White" BorderBrush="#495057"/>
            </StackPanel>

            <TextBlock Text="Cliente / Aparelho" Foreground="#ADB5BD" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtClienteAparelho" Height="35" Padding="5" Margin="0,0,0,12" Background="#2B3035" Foreground="White" BorderBrush="#495057"/>

            <TextBlock Text="Contato" Foreground="#ADB5BD" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtContato" Height="32" Padding="5" Margin="0,0,0,12" Background="#2B3035" Foreground="White" BorderBrush="#495057"/>

            <TextBlock Text="Descrição do Serviço / Peças" Foreground="#ADB5BD" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtDescricaoOrc" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Padding="5" Margin="0,0,0,12" Background="#2B3035" Foreground="White" BorderBrush="#495057"/>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Valor da Peça (R$)" Foreground="#ADB5BD" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtValorPeca" Height="35" Padding="5" Background="#2B3035" Foreground="White" BorderBrush="#495057" TextChanged="CalcularTotal"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Mão de Obra (R$)" Foreground="#ADB5BD" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtMaoObra" Height="35" Padding="5" Background="#2B3035" Foreground="White" BorderBrush="#495057" TextChanged="CalcularTotal"/>
                </StackPanel>
            </Grid>

            <Border Background="#1A1D20" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                <TextBlock x:Name="LblTotalOrcamento" Text="Total do Orçamento: R$ 0,00" Foreground="#20C997" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>

            <Button Content="Imprimir Orçamento" Height="42" Background="#198754" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnImprimirOrcamento_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>